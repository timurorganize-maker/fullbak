# Supabase — оставьте пустым, чтобы работать на моковых данных (режим прототипа).
# Заполните, чтобы подключить реальную БД (см. supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Опционально: ключ Yandex Maps JS API (сейчас используется MapLibre + OSM-тайлы,
# ключ не требуется).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
